# Copy to .env.production (gitignored) and fill in. Generate secrets with: openssl rand -hex 32
# WARNING: NEVER reuse dev values (any_key, any_secret, postgrespassword) or the old dev JWT key
# that exists in git history. Every secret below must be freshly generated.

POSTGRES_PASSWORD=CHANGE_ME      # database password
JWT_SECRET=CHANGE_ME             # token signing key (>= 32 bytes); rotating it logs everyone out
S3_ACCESS_KEY=CHANGE_ME          # object storage key (openssl rand -hex 16)
S3_SECRET_KEY=CHANGE_ME          # object storage secret (openssl rand -hex 32)
PUBLIC_ORIGIN=https://drive.example.com  # public URL users open (scheme + host, no trailing slash)
# BOOTSTRAP_ADMIN_EMAIL=you@example.com  # upgrades only: promotes this user to admin if no admin exists, see docs/DEPLOY.md
STORAGE_QUOTA_BYTES=5368709120   # default per-user quota in bytes (5 GiB); admins can override it per user
MAX_UPLOAD_BYTES=104857600       # max single upload in bytes (100 MiB)
WEB_BIND=127.0.0.1               # host interface for the web port; keep loopback behind a TLS proxy
WEB_PORT=8080                    # host port for the web container
# Optional off-host backup. NOT read from this file: export it in the shell/cron environment of scripts/backup.sh
# (rclone must be installed and configured), e.g. BACKUP_RCLONE_REMOTE=s3remote:arcano-backups
