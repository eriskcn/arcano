{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=arcanocore;Username=postgres;Password=postgrespassword"
  },
  "Storage": {
    "ServiceUrl": "http://seaweedfs:8333",
    "AccessKey": "any_key",
    "SecretKey": "any_secret",
    "BucketName": "arcanocore-bucket",
    "QuotaBytes": 5368709120,
    "MaxUploadBytes": 104857600
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cleanup": {
    "Enabled": true,
    "IntervalMinutes": 60
  },
  "Auth": {
    "BootstrapAdminEmail": ""
  },
  "Jwt": {
    "Issuer": "ArcanoCore",
    "Audience": "ArcanoCoreUsers",
    "ExpiryInMinutes": 60
  }
}
